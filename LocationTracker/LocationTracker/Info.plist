<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Location Tracker</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>LocationTracker</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSHealthShareUsageDescription</key>
	<string>Location Tracker uses your health data (steps, sleep, heart rate, calories, exercise, stand time, workouts) to sync daily summaries to your homepage and Cosmo briefings.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Location Tracker does not write health data; it only reads your step count, sleep, heart rate, active and dietary calories, exercise and stand time, and workouts to sync to your homepage.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Location Tracker needs location access to automatically update your homepage with your current city when you travel.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Location Tracker uses background location monitoring to update your homepage automatically when you change cities.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Location Tracker needs location access to update your homepage with your current city.</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.ckubal.LocationTracker.locationRefresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
		<string>background-processing</string>
		<string>background-fetch</string>
		<string>processing</string>
		<string>fetch</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
